# Azure Foundry (required for the agent)
ANTHROPIC_FOUNDRY_API_KEY=
# Endpoint: the URL, or the resource name (not both)
ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_RESOURCE=<resource>
AGENT_MODEL=

# Optional (defaults shown)
EQUIP_DB_PATH=./data/equipment.db
AS_OF_DATE=2026-12-01
AGENT_MAX_STEPS=8
REFLECTION_MAX_REVISIONS=2
