{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(cat *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep *.env)",
      "Bash(source *.env)",
      "Bash(. *.env)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "timeout": 180,
            "statusMessage": "Running pytest..."
          }
        ]
      }
    ]
  }
}
